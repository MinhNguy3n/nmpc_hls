+static top_t u_error_term_rd(top_t Jui_in, top_t current_uu, top_t uref_j, top_t uprev_j, int j) {
+#pragma HLS INLINE off
+#ifdef PSO_RD_UREF
+    const top_t tmp_err = current_uu - uref_j;
+#else
+    const top_t tmp_err = current_uu - _uss[j];
+#endif
