+#ifdef PSO_RD_UREF
+        const top_t e_w = _rd_Wr[j] * tmp_err;
+        r = Jui_in + e_w * e_w + du_w * du_w;
+#else
+        r = Jui_in + _R[j] * tmp_err * tmp_err + du_w * du_w;
+#endif
+    } else
+        r = Jui_in + (top_t)1e4 * tmp_err * tmp_err + du_w * du_w;
+    return r;
+}
+#endif
