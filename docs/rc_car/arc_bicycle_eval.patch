+static void pf_rotate(top_t ex, top_t ey, top_t c, top_t s, top_t *e_lat, top_t *e_lon) {
+#pragma HLS INLINE off
+    const top_t lon = c * ex + s * ey;
+    const top_t lat = c * ey - s * ex;
+    *e_lat = lat;
+    *e_lon = lon;
+}
+// One weighted path-frame term (component j = 0 lateral, 1 along-track), as rd_one_step_error_pf.
+static top_t pf_error_term(top_t Ji_in, top_t x_hat_j, top_t tmp_err, int j, bool last) {
+#pragma HLS INLINE off
+    const top_t Q_local = last ? _rd_Qf_pf[j] : _rd_Q_pf[j];
+    top_t penality;
+    if ((_state_lower_limits[j] <= x_hat_j) && (x_hat_j <= _state_upper_limits[j]))
+        penality = (top_t)Q_local;
+    else
+        penality = (top_t)1e4;
+    top_t r = Ji_in + penality * tmp_err * tmp_err;
+    return r;
+}
+#endif
